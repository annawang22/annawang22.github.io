# --- Private / local-only (never published to GitHub Pages) ---
assets/private/*
!assets/private/.gitkeep
private/

# Resumes & documents — request via email, do not host on the site
assets/*.pdf
*.pdf

# Old / superseded assets (keep a copy in assets/private/ if you still want them)
assets/profilepic.jpg

# OS & editor junk
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / backup files
*~
*.swp
*.swo
*.bak
*.tmp
